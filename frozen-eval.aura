;; Runs the frozen check once: scripts/frozen.sh verifies the hashes first.
;; Writes out/frozen-v1.json.
(require "lib/frozen")
(require "std/fs" all:)

(define spec (json-parse (read-file "frozen/v1.json")))
(fz-check-defs spec)
(boot! (params-code BASE-PARAMS))
(make-directory "out")

(define seeds (hash-ref spec "seeds"))
(define t0 (monotonic-ms))
(define per-seed
  (map (lambda (s) (let ((tapes (make-tapes s (hash-ref spec "tapes-per-seed"))))
                     (hash "select" (fz-select spec (string-append "seed " (number->string s)) tapes)
                           "detect" (fz-detect spec s tapes))))
       seeds))
(define alpha (hash-ref (hash-ref spec "selector") "gate-alpha"))
(define sels (map (lambda (r) (hash-ref r "select")) per-seed))
(define (cat key) (apply append (map (lambda (r) (hash-ref r key)) sels)))
(define pooled-bar (tune:gate (cat "bar-oos") (cat "sbs-oos") (hash "alpha" alpha "sense" "max")))
(define pooled-rg (tune:gate (cat "regime-oos") (cat "sbs-oos") (hash "alpha" alpha "sense" "max")))
(define dets (map (lambda (r) (hash-ref r "detect")) per-seed))
(define (dsum k) (apply + (map (lambda (d) (hash-ref d k)) dets)))

(define real-path (hash-ref (hash-ref spec "real") "csv"))
(define real
  (if (file-exists? real-path)
    (fz-select spec "ECB EUR/USD" (fz-real-tapes real-path (hash-ref (hash-ref spec "real") "tapes")))
    #f))

(define (strip r) (hash "label" (hash-ref r "label") "sbs" (hash-ref r "sbs") "test-windows" (hash-ref r "test-windows")
                        "sbs-sum" (hash-ref r "sbs-sum") "bar-sum" (hash-ref r "bar-sum") "regime-sum" (hash-ref r "regime-sum")
                        "oracle-sum" (hash-ref r "oracle-sum") "bar-t" (hash-ref r "bar-t") "bar-keep" (hash-ref r "bar-keep")
                        "regime-t" (hash-ref r "regime-t") "regime-keep" (hash-ref r "regime-keep")
                        "bar-def" (hash-ref r "bar-def") "bar-table" (hash-ref r "bar-table")))
(define report
  (hash "spec-version" (hash-ref spec "version")
        "seeds" (map (lambda (r) (hash "select" (strip (hash-ref r "select")) "detect" (hash-ref r "detect"))) per-seed)
        "pooled" (hash "bar-t" (fz-r2 (hash-ref pooled-bar "t")) "bar-keep" (hash-ref pooled-bar "keep")
                       "bar-mean-diff" (fz-r2 (hash-ref pooled-bar "mean-diff"))
                       "regime-t" (fz-r2 (hash-ref pooled-rg "t")) "regime-keep" (hash-ref pooled-rg "keep")
                       "bar-gates" (length (filter (lambda (r) (hash-ref r "bar-keep")) sels))
                       "regime-gates" (length (filter (lambda (r) (hash-ref r "regime-keep")) sels))
                       "sbs-sum" (fz-r2 (m-sum (cat "sbs-oos"))) "bar-sum" (fz-r2 (m-sum (cat "bar-oos")))
                       "regime-sum" (fz-r2 (m-sum (cat "regime-oos"))) "oracle-sum" (fz-r2 (m-sum (cat "oracle-oos"))))
        "detector" (hash "changes" (dsum "changes") "hits" (dsum "hits") "false" (dsum "false")
                         "bars" (dsum "bars") "stationary-bars" (dsum "stationary-bars")
                         "stationary-alarms" (dsum "stationary-alarms"))
        "real" (if real (strip real) #f)
        "ms" (- (monotonic-ms) t0)))
(write-file "out/frozen-v1.json" (json-encode report))

(for-each (lambda (r) (let ((s (hash-ref r "select")) (d (hash-ref r "detect")))
  (display "FZ ") (display (hash-ref s "label")) (display " sbs(") (display (hash-ref s "sbs")) (display ")=") (display (hash-ref s "sbs-sum"))
  (display " regime=") (display (hash-ref s "regime-sum")) (display " bar=") (display (hash-ref s "bar-sum"))
  (display " t=") (display (hash-ref s "bar-t")) (display (if (hash-ref s "bar-keep") " KEEP" ""))
  (display " oracle=") (display (hash-ref s "oracle-sum")) (display " def=") (display (hash-ref s "bar-def"))
  (display " table=") (display (hash-ref s "bar-table"))
  (display " | changes=") (display (hash-ref d "changes")) (display " hits=") (display (hash-ref d "hits"))
  (display " false=") (display (hash-ref d "false")) (display " stationary-alarms=") (display (hash-ref d "stationary-alarms"))
  (newline))) per-seed)
(display "FZ pooled ") (display (hash->list (hash-ref report "pooled"))) (newline)
(display "FZ detector ") (display (hash->list (hash-ref report "detector"))) (newline)
(if real (begin (display "FZ real ") (display (hash->list (strip real))) (newline)) (begin (display "FZ real skipped") (newline)))
(display "FZ_OK") (newline)
