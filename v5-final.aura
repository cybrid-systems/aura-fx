;; v5 final test, run once by scripts/v5-final.sh after the freeze commit.
;; Applies the frozen adaptive variant(s) to EUR/GBP (never downloaded
;; before the freeze): decisions from test-from, the earlier days are
;; window history only. Runs at 1x and 2x costs. Writes out/v5-final.json
;; (daily P&L per run, switch / heal counts and per-decision latency);
;; scripts/v5-report.py turns it into the tables.
(require "lib/v5")
(require "std/fs" all:)

(define spec (json-parse (read-file "frozen/v5.json")))
(define from (hash-ref spec "test-from"))
(v5-boot!)
(define sets (list (list "x1" "data/v5/final-eurgbp-net.csv" "data/v5/final-eurgbp-pos.csv")
                   (list "x2" "data/v5/final2x-eurgbp-net.csv" "data/v5/final2x-eurgbp-pos.csv")))
(define (run-one d v)
  (let* ((a (v5-day-index d from)) (t0 (monotonic-ms))
         (r (v5-run d (hash "N" (hash-ref v "N") "W" (hash-ref v "W") "method" (hash-ref v "method")) a (hash-ref d "n"))))
    (hash "name" (hash-ref v "name") "daily" (map (lambda (x) (m-round x 2)) (hash-ref r "daily"))
          "switches" (hash-ref r "switches") "heals" (hash-ref r "heals") "swap-fail" (hash-ref r "swap-fail")
          "alarms" (hash-ref r "alarms") "decisions" (hash-ref r "decisions") "dec-ms" (hash-ref r "dec-ms")
          "swap-ms" (hash-ref r "swap-ms") "switch-cost" (m-round (hash-ref r "switch-cost") 2)
          "timeline" (hash-ref r "timeline") "ms" (- (monotonic-ms) t0))))
(define results
  (map (lambda (s)
         (let* ((d (v5-load (cadr s) (caddr s))) (a (v5-day-index d from)))
           (hash "cost" (car s)
                 "days" (let loop ((i (- (hash-ref d "n") 1)) (acc (list))) (if (< i a) acc (loop (- i 1) (cons (vector-ref (hash-ref d "days") i) acc))))
                 "runs" (map (lambda (v) (run-one d v)) (hash-ref spec "adaptive-runs")))))
       sets))
(write-file "out/v5-final.json" (json-encode (hash "spec" (hash-ref spec "version") "results" results)))
(for-each (lambda (s)
            (for-each (lambda (r)
                        (display "V5F ") (display (hash-ref s "cost")) (display " ") (display (hash-ref r "name"))
                        (display " sum=") (display (m-round (m-sum (hash-ref r "daily")) 2))
                        (display " switches=") (display (hash-ref r "switches")) (display " heals=") (display (hash-ref r "heals"))
                        (display " fails=") (display (hash-ref r "swap-fail")) (display " ms=") (display (hash-ref r "ms")) (newline))
                      (hash-ref s "runs")))
          results)
(display "V5_FINAL_OK") (newline)
