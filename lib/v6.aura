;; v6: online adaptation on precomputed basket columns (carry + cross-section).
;;
;; scripts/v6-prep.py writes one daily net-P&L column per committed config,
;; end-of-day positions per config and pair, and the USD unit cost of a
;; 1-lot position change per pair. Aura is the control plane: every N
;; trading days it scores all configs on the last W days (prefix sums),
;; picks a config (greedy / tune:gate / tune:race / drift), isolates the
;; candidate with evo:trial, installs it with hot-strategy:swap! on
;; active-config, and rolls back with hot-strategy:heal! when the new
;; config has lost money since the switch while the previous one would
;; have made more. select:drift? on the live daily P&L can force an early
;; decision. Switching pays sum_p |pos_new,p - pos_old,p| x unit cost_p.
(require "lib/metrics")
(require "std/string" all:)
(require "std/list" all:)
(require "std/hyper-heuristic" all:)
(require "std/hot-strategy" all:)
(require "std/evo-core" all:)
(require "std/algo-select" all:)

(define (v6-split-pipe s)
  (let ((n (string-length s)))
    (let loop ((i 0))
      (cond ((>= i n) (cons s ""))
            ((char=? (string-ref s i) #\|)
             (cons (substring s 0 i) (substring s (+ i 1) n)))
            (else (loop (+ i 1)))))))

(define (v6-index xs name)
  (let loop ((ys xs) (i 0))
    (cond ((null? ys) -1)
          ((string=? (car ys) name) i)
          (else (loop (cdr ys) (+ i 1))))))

(define (v6-load netfile posfile unitfile)
  (let* ((nlines (filter (lambda (l) (> (string-length l) 0)) (string-split (read-file netfile) "\n")))
         (names (cdr (string-split (car nlines) ",")))
         (nrows (map (lambda (l) (string-split l ",")) (cdr nlines)))
         (n (length nrows)) (nc (length names))
         (cols (make-vector nc #f))
         (ulines (filter (lambda (l) (> (string-length l) 0)) (string-split (read-file unitfile) "\n")))
         (pairs (cdr (string-split (car ulines) ",")))
         (m (length pairs))
         (urows (map (lambda (l) (string-split l ",")) (cdr ulines)))
         (unit (make-vector m #f))
         (plines (filter (lambda (l) (> (string-length l) 0)) (string-split (read-file posfile) "\n")))
         (pcols (cdr (string-split (car plines) ",")))
         (prows (map (lambda (l) (cdr (string-split l ","))) (cdr plines)))
         (pmap (map v6-split-pipe pcols)))
    (let fill ((k 0))
      (if (< k nc) (begin (vector-set! cols k (make-vector n 0.0)) (fill (+ k 1))) #t))
    (let fu ((j 0))
      (if (< j m) (begin (vector-set! unit j (make-vector n 0.0)) (fu (+ j 1))) #t))
    (let ((pos (make-vector nc #f)))
      (let pk ((k 0))
        (if (< k nc)
          (let ((pv (make-vector m #f)))
            (let pj ((j 0))
              (if (< j m) (begin (vector-set! pv j (make-vector n 0.0)) (pj (+ j 1))) #t))
            (vector-set! pos k pv)
            (pk (+ k 1)))
          #t))
      (let rowl ((rs nrows) (us urows) (ps prows) (i 0))
        (if (null? rs) #t
          (begin
            (let cl ((xs (cdr (car rs))) (k 0))
              (if (null? xs) #t
                (begin (vector-set! (vector-ref cols k) i (exact->inexact (string->number (car xs))))
                       (cl (cdr xs) (+ k 1)))))
            (let ul ((xs (cdr (car us))) (j 0))
              (if (null? xs) #t
                (begin (vector-set! (vector-ref unit j) i (exact->inexact (string->number (car xs))))
                       (ul (cdr xs) (+ j 1)))))
            (let pl ((xs (car ps)) (hs pmap))
              (if (null? xs) #t
                (let* ((h (car hs)) (k (v6-index names (car h))) (j (v6-index pairs (cdr h))))
                  (if (if (>= k 0) (>= j 0) #f)
                    (vector-set! (vector-ref (vector-ref pos k) j) i (exact->inexact (string->number (car xs))))
                    #t)
                  (pl (cdr xs) (cdr hs)))))
            (rowl (cdr rs) (cdr us) (cdr ps) (+ i 1)))))
      (let ((s1 (make-vector nc #f)) (s2 (make-vector nc #f)))
        (let pk ((k 0))
          (if (< k nc)
            (let ((a (make-vector (+ n 1) 0.0)) (b (make-vector (+ n 1) 0.0)) (c (vector-ref cols k)))
              (let pi ((i 0))
                (if (< i n)
                  (let ((x (vector-ref c i)))
                    (vector-set! a (+ i 1) (+ (vector-ref a i) x))
                    (vector-set! b (+ i 1) (+ (vector-ref b i) (* x x)))
                    (pi (+ i 1)))
                  #t))
              (vector-set! s1 k a) (vector-set! s2 k b)
              (pk (+ k 1)))
            #t))
        (hash "days" (list->vector (map car nrows)) "n" n "nc" nc "m" m
              "names" (list->vector names) "pairs" (list->vector pairs)
              "cols" cols "pos" pos "unit" unit "s1" s1 "s2" s2)))))

(define (v6-day-index d iso)
  (let ((days (hash-ref d "days")) (n (hash-ref d "n")))
    (let loop ((i 0))
      (cond ((>= i n) n)
            ((string<? (vector-ref days i) iso) (loop (+ i 1)))
            (else i)))))

(define (v6-pnl d k i) (if (< k 0) 0.0 (vector-ref (vector-ref (hash-ref d "cols") k) i)))
(define (v6-sum d k a b)
  (if (< k 0) 0.0 (let ((s (vector-ref (hash-ref d "s1") k))) (- (vector-ref s b) (vector-ref s a)))))
(define (v6-wsharpe d k a b)
  (if (< k 0) 0.0
    (let* ((s1 (vector-ref (hash-ref d "s1") k)) (s2 (vector-ref (hash-ref d "s2") k))
           (nn (exact->inexact (- b a)))
           (m (/ (- (vector-ref s1 b) (vector-ref s1 a)) nn))
           (v (- (/ (- (vector-ref s2 b) (vector-ref s2 a)) nn) (* m m))))
      (if (< v 1e-12) 0.0 (/ m (sqrt v))))))
(define (v6-window d k a b)
  (let loop ((i (- b 1)) (acc (list))) (if (< i a) acc (loop (- i 1) (cons (v6-pnl d k i) acc)))))

(define (v6-switch-cost d k-from k-to i)
  (let* ((m (hash-ref d "m")) (unit (hash-ref d "unit"))
         (pref (lambda (k p)
                 (if (< k 0) 0.0
                   (let ((ii (max 0 (- i 1))))
                     (vector-ref (vector-ref (vector-ref (hash-ref d "pos") k) p) ii))))))
    (let loop ((p 0) (acc 0.0))
      (if (>= p m) acc
        (loop (+ p 1)
              (+ acc (* (abs (- (pref k-to p) (pref k-from p)))
                        (vector-ref (vector-ref unit p) i))))))))

(define (v6-boot!)
  (set-code "(define (active-config) -1)")
  (eval-current)
  (hot-strategy:register! "active-config" "(lambda () -1)"))
(define (v6-live) (active-config))

(define (v6-ranked d a b)
  (let loop ((k 0) (acc (list (cons 0.0 -1))))
    (if (>= k (hash-ref d "nc"))
      (sort acc (lambda (x y) (> (car x) (car y))))
      (loop (+ k 1) (cons (cons (v6-wsharpe d k a b) k) acc)))))

(define (v6-take xs n)
  (let loop ((ys xs) (k n) (acc (list)))
    (if (if (null? ys) #t (<= k 0)) (reverse acc)
      (loop (cdr ys) (- k 1) (cons (car ys) acc)))))
(define (v6-dedup xs)
  (let loop ((ys xs) (acc (list)))
    (if (null? ys) (reverse acc)
      (loop (cdr ys) (if (member (car ys) acc) acc (cons (car ys) acc))))))

(define (v6-choose method d active a b drifted?)
  (let* ((ranked (v6-ranked d a b)) (top (cdr (car ranked))))
    (cond
      ((string=? method "greedy") top)
      ((string=? method "gate")
       (if (= top active) active
         (let ((g (tune:gate (v6-window d top a b) (v6-window d active a b)
                             (hash "alpha" 0.05 "sense" "max"))))
           (if (hash-ref g "keep") top active))))
      ((string=? method "drift")
       (if (not drifted?) top
         (if (< (v6-wsharpe d active a b) 0.0) -1
           (if (= top active)
             (if (if (pair? ranked) (pair? (cdr ranked)) #f) (cdr (cadr ranked)) -1)
             top))))
      (else
       (let* ((cands (v6-dedup (append (map cdr (v6-take ranked 8)) (list active -1))))
              (blocks (let bl ((s a) (acc (list)))
                        (if (> (+ s 5) b) (reverse acc) (bl (+ s 5) (cons s acc)))))
              (r (tune:race (map (lambda (k) (hash "name" (number->string k) "k" k)) cands)
                            (hash "instances" blocks "seeds" (list 1) "alpha" 0.05 "min-instances" 4
                                  "evaluate" (lambda (cfg s seed)
                                               (/ (v6-sum d (hash-ref cfg "k") s (+ s 5)) 5.0))))))
         (let ((w (hash-ref r "winner"))) (if w (string->number w) active)))))))

(define (v6-try-choice d choice)
  (let ((r (evo:trial (hash "id" (number->string choice) "k" choice)
                      (hash "evaluate" (lambda (cand) (hash "objectives" (hash "k" (exact->inexact choice))))
                            "timeout-ms" 8000))))
    (evo:trial-ok? r)))

(define (v6-run d opts a b)
  (let* ((N (hash-ref opts "N")) (W (hash-ref opts "W")) (method (hash-ref opts "method"))
         (active -1) (last-good -1) (since a) (next a)
         (sel (select:make (hash "drift-threshold" 0.35)))
         (daily (list)) (switches 0) (heals 0) (swap-fail 0) (trial-fail 0)
         (alarms 0) (decisions 0) (dec-ms (list)) (swap-ms (list))
         (switch-cost 0.0) (timeline (list)))
    (hot-strategy:swap! "active-config" "(lambda () -1)" "v6 run start")
    (if (= (v6-live) -1) #t (error "v6-run: could not reset active-config"))
    (let day ((i a))
      (if (>= i b)
        (hash "daily" (reverse daily) "switches" switches "heals" heals "swap-fail" swap-fail
              "trial-fail" trial-fail "alarms" alarms "decisions" decisions
              "dec-ms" (reverse dec-ms) "swap-ms" (reverse swap-ms)
              "switch-cost" switch-cost "timeline" (reverse timeline) "final" active)
        (begin
          (if (>= i next)
            (let* ((t0 (monotonic-ms))
                   (heal? (if (> i since)
                            (if (< (v6-sum d active since i) 0.0)
                              (> (v6-sum d last-good since i) (v6-sum d active since i))
                              #f)
                            #f))
                   (drifted? (select:drift? sel))
                   (choice (if heal? last-good (v6-choose method d active (- i W) i drifted?))))
              (set! decisions (+ decisions 1))
              (if drifted? (set! alarms (+ alarms 1)) #t)
              (if (= choice active) #t
                (let ((ok-trial (if heal? #t (v6-try-choice d choice))))
                  (if (not ok-trial)
                    (set! trial-fail (+ trial-fail 1))
                    (let* ((t1 (monotonic-ms))
                           (ok (if heal?
                                 (hot-strategy:heal! "active-config")
                                 (car (hot-strategy:swap! "active-config"
                                                          (string-append "(lambda () " (number->string choice) ")")
                                                          "v6 switch"))))
                           (live (v6-live)))
                      (set! swap-ms (cons (- (monotonic-ms) t1) swap-ms))
                      (if (if ok (= live choice) #f)
                        (begin
                          (let ((c (v6-switch-cost d active choice i)))
                            (set! switch-cost (+ switch-cost c))
                            (set! daily (cons (- 0.0 c) daily)))
                          (if heal? (set! heals (+ heals 1)) (set! switches (+ switches 1)))
                          (set! timeline (cons (list i choice (if heal? "heal" "swap")) timeline))
                          (if heal? #t (set! last-good active))
                          (set! active choice) (set! since i))
                        (begin (set! swap-fail (+ swap-fail 1))
                               (set! active live)))))))
              (set! next (+ i N))
              (set! dec-ms (cons (- (monotonic-ms) t0) dec-ms)))
            #t)
          (let* ((x (v6-pnl d active i))
                 (merged (if (if (pair? daily) (= (length daily) (+ (- i a) 1)) #f)
                           (let ((c (car daily))) (set! daily (cdr daily)) (+ x c))
                           x)))
            (set! daily (cons merged daily))
            (select:feedback! sel (hash "t" i) (number->string active) x)
            (if (select:drift? sel) (set! next (min next (+ i 1))) #t))
          (day (+ i 1)))))))
