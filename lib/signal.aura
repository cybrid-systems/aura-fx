;; Three signals. Each is (lambda (prices i prev) -> -1, 0, or 1).
;; prev is the previous signal, in lots. breakout holds it inside the channel.
;; trend and meanrev ignore it. Lookback is 8 bars (sma) or 12 (channel).

(define (sma prices i n)
  (let loop ((k 0) (s 0.0))
    (if (>= k n) (/ s n)
      (loop (+ k 1) (+ s (list-ref prices (- i k)))))))

(define (roll-max prices end n)
  (let loop ((k 0) (m (list-ref prices end)))
    (if (>= k n) m
      (let ((v (list-ref prices (- end k))))
        (loop (+ k 1) (if (> v m) v m))))))

(define (roll-min prices end n)
  (let loop ((k 0) (m (list-ref prices end)))
    (if (>= k n) m
      (let ((v (list-ref prices (- end k))))
        (loop (+ k 1) (if (< v m) v m))))))

(define (sgn x)
  (cond ((> x 0.0) 1) ((< x 0.0) -1) (else 0)))

;; Sign changes among the n one-bar deltas ending at i.
(define (chop-count prices i n)
  (let loop ((k (+ (- i n) 1)) (prev 0) (c 0))
    (if (> k i) c
      (let ((d (sgn (- (list-ref prices k) (list-ref prices (- k 1))))))
        (loop (+ k 1)
              (if (= d 0) prev d)
              (if (and (not (= d 0)) (not (= prev 0)) (not (= d prev)))
                (+ c 1) c))))))

;; slope: pips over the last 16 bars. chop: sign changes in that window.
(define (window-features prices i)
  (hash "slope" (* (- (list-ref prices i) (list-ref prices (- i 16))) 10000.0)
        "chop" (* 1.0 (chop-count prices i 16))))

(define (trend-signal prices i prev)
  (if (< i 8) 0
    (let ((d (- (list-ref prices i) (sma prices i 8))))
      (cond ((> d 0.00025) 1)
            ((< d -0.00025) -1)
            (else 0)))))

(define (meanrev-signal prices i prev)
  (if (< i 8) 0
    (let ((d (- (list-ref prices i) (sma prices i 8))))
      (cond ((> d 0.00060) -1)
            ((< d -0.00060) 1)
            (else 0)))))

(define (breakout-signal prices i prev)
  (if (< i 12) prev
    (let ((hi (roll-max prices (- i 1) 12))
          (lo (roll-min prices (- i 1) 12))
          (p (list-ref prices i)))
      (cond ((> p hi) 1)
            ((< p lo) -1)
            (else prev)))))

(define (signal-fn name)
  (cond ((string=? name "meanrev") meanrev-signal)
        ((string=? name "breakout") breakout-signal)
        (else trend-signal)))
