;; v6 final test, run once by scripts/v6-final.sh after the freeze commit.
;; Applies the frozen adaptive variant(s) to the 8-pair basket that was
;; never downloaded before the freeze. Decisions start at test-from; the
;; earlier days are window history only. Runs at 1x and 2x costs.
(require "lib/v6")
(require "std/fs" all:)

(define spec (json-parse (read-file "frozen/v6.json")))
(define from (hash-ref spec "test-from"))
(v6-boot!)
(define sets (list (list "x1" "data/v6/final-net.csv" "data/v6/final-pos.csv" "data/v6/final-unit.csv")
                   (list "x2" "data/v6/final2x-net.csv" "data/v6/final2x-pos.csv" "data/v6/final2x-unit.csv")))
(define (run-one d v)
  (let* ((a (v6-day-index d from)) (t0 (monotonic-ms))
         (r (v6-run d (hash "N" (hash-ref v "N") "W" (hash-ref v "W") "method" (hash-ref v "method"))
                    a (hash-ref d "n"))))
    (hash "name" (hash-ref v "name") "daily" (map (lambda (x) (m-round x 2)) (hash-ref r "daily"))
          "switches" (hash-ref r "switches") "heals" (hash-ref r "heals") "swap-fail" (hash-ref r "swap-fail")
          "trial-fail" (hash-ref r "trial-fail") "alarms" (hash-ref r "alarms")
          "decisions" (hash-ref r "decisions") "dec-ms" (hash-ref r "dec-ms") "swap-ms" (hash-ref r "swap-ms")
          "switch-cost" (m-round (hash-ref r "switch-cost") 2)
          "timeline" (hash-ref r "timeline") "ms" (- (monotonic-ms) t0))))
(define results
  (map (lambda (s)
         (let* ((d (v6-load (cadr s) (caddr s) (cadddr s))) (a (v6-day-index d from)))
           (hash "cost" (car s)
                 "days" (let loop ((i (- (hash-ref d "n") 1)) (acc (list)))
                          (if (< i a) acc (loop (- i 1) (cons (vector-ref (hash-ref d "days") i) acc))))
                 "runs" (map (lambda (v) (run-one d v)) (hash-ref spec "adaptive-runs")))))
       sets))
(write-file "out/v6-final.json" (json-encode (hash "spec" (hash-ref spec "version") "results" results)))
(for-each (lambda (s)
            (for-each (lambda (r)
                        (display "V6F ") (display (hash-ref s "cost")) (display " ") (display (hash-ref r "name"))
                        (display " sum=") (display (m-round (m-sum (hash-ref r "daily")) 2))
                        (display " switches=") (display (hash-ref r "switches"))
                        (display " heals=") (display (hash-ref r "heals"))
                        (display " fails=") (display (hash-ref r "swap-fail"))
                        (display " ms=") (display (hash-ref r "ms")) (newline))
                      (hash-ref s "runs")))
          results)
(display "V6_FINAL_OK") (newline)
