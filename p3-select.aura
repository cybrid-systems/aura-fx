;; P3b: do the selectors have anything to learn once the portfolio holds
;; different rule families? Runs on several seeds (not only seed 7) with
;; one fixed pool and reports, per seed, the out-of-sample sum of:
;;   SBS          the single best member on train (windows 1..4)
;;   regime       lib/regime per-window selector (cell at the bar before)
;;   bar          lib/regime bar-level composite (cell at every bar)
;;   oracle       best member of every test window, after the fact
;; Test windows are 5..7 of six tapes (18). Gate: tune:gate alpha 0.05
;; against SBS. Nothing is tuned on the test windows. Seeds and pool are
;; fixed here. out/p3-select.json.

(require "lib/members")
(require "lib/regime")
(require "std/hyper-heuristic" all:)

(define SEEDS (list 7 11 23 31 47))
(boot! (params-code BASE-PARAMS))
(make-directory "out")

(define pool (append (shipped-members) (family-members)))
(define names (map (lambda (m) (hash-ref m "name")) pool))
(define rules (foldl (lambda (h m) (hash-set h (hash-ref m "name") (member-closure m))) (hash) pool))
(define (r2 x) (m-round x 2))

(define (window-pnls wn)
  (foldl (lambda (h n) (hash-set h n (hash-ref (sim-win (hash-ref rules n) wn) "pnl"))) (hash) names))

(define (regime-online sel cuts test test-pnls)
  (let loop ((ws (map cons test test-pnls)) (sel sel) (acc (list)))
    (if (null? ws) (reverse acc)
      (let* ((w (hash-ref (car (car ws)) "w"))
             (grp (filter (lambda (x) (= (hash-ref (car x) "w") w)) ws))
             (rest (filter (lambda (x) (not (= (hash-ref (car x) "w") w))) ws))
             (rows (map (lambda (x) (hash-ref (cdr x) (car (regime-choose sel (regime-cell cuts (win-features (car x)))))))
                        grp))
             (sel2 (foldl (lambda (s x) (regime-add s (regime-cell cuts (win-features (car x))) (cdr x))) sel grp)))
        (loop rest sel2 (append (reverse rows) acc))))))

(define (by-regime ws xs rg)
  (m-sum (map cdr (filter (lambda (p) (string=? (hash-ref (car p) "regime") rg)) (map cons ws xs)))))

(define (run-seed seed)
  (let* ((tapes (make-tapes seed 6))
         (train (wins tapes (list 1 2 3 4)))
         (test (sort (wins tapes (list 5 6 7)) (lambda (a b) (< (hash-ref a "w") (hash-ref b "w")))))
         (train-pnls (par-map window-pnls train))
         (test-pnls (par-map window-pnls test))
         (sbs (car (foldl (lambda (b n) (let ((v (m-sum (map (lambda (h) (hash-ref h n)) train-pnls))))
                                          (if (or (not b) (> v (cdr b))) (cons n v) b)))
                          #f names)))
         (sbs-oos (map (lambda (h) (hash-ref h sbs)) test-pnls))
         (oracle (map (lambda (h) (apply max (map (lambda (n) (hash-ref h n)) names))) test-pnls))
         (cuts (regime-cuts (map win-features train)))
         (sel (regime-fit names (map (lambda (wn h) (cons (regime-cell cuts (win-features wn)) h)) train train-pnls) sbs))
         (rg-oos (regime-online sel cuts test test-pnls))
         (fit (bar-fit-auto names rules sbs train par-map))
         (bar-oos (hash-ref (eval-rule (bar-composite (hash-ref fit "table") rules) test) "pnls"))
         (g-rg (tune:gate rg-oos sbs-oos (hash "alpha" 0.05 "sense" "max")))
         (g-bar (tune:gate bar-oos sbs-oos (hash "alpha" 0.05 "sense" "max"))))
    (hash "seed" seed "sbs" sbs "sbs-oos" (r2 (m-sum sbs-oos)) "oracle-oos" (r2 (m-sum oracle))
          "regime-oos" (r2 (m-sum rg-oos)) "regime-t" (r2 (hash-ref g-rg "t")) "regime-keep" (hash-ref g-rg "keep")
          "bar-oos" (r2 (m-sum bar-oos)) "bar-t" (r2 (hash-ref g-bar "t")) "bar-keep" (hash-ref g-bar "keep")
          "bar-def" (hash-ref fit "def") "bar-table" (hash-ref fit "table") "bar-steps" (hash-ref fit "steps") "bar-defs" (hash-ref fit "all")
          "test-regimes" (map (lambda (w) (hash-ref w "regime")) test)
          "sbs-by-regime" (map (lambda (rg) (r2 (by-regime test sbs-oos rg))) (list "up" "range" "down"))
          "oracle-by-regime" (map (lambda (rg) (r2 (by-regime test oracle rg))) (list "up" "range" "down"))
          "bar-by-regime" (map (lambda (rg) (r2 (by-regime test bar-oos rg))) (list "up" "range" "down")))))

(define t0 (monotonic-ms))
(define rows (map run-seed SEEDS))
(define ms (- (monotonic-ms) t0))
(write-file "out/p3-select.json" (json-encode (hash "pool" (map member->json pool) "seeds" rows)))
(for-each (lambda (r)
  (display "P3S seed=") (display (hash-ref r "seed")) (display " sbs(") (display (hash-ref r "sbs")) (display ")=")
  (display (hash-ref r "sbs-oos")) (display " regime=") (display (hash-ref r "regime-oos"))
  (display " t=") (display (hash-ref r "regime-t")) (display " bar=") (display (hash-ref r "bar-oos"))
  (display " t=") (display (hash-ref r "bar-t")) (display " keep=") (display (hash-ref r "bar-keep"))
  (display " oracle=") (display (hash-ref r "oracle-oos"))
  (display " def=") (display (hash-ref r "bar-def")) (display " bar-table=") (display (map (lambda (c) (hash-ref (hash-ref r "bar-table") c)) BAR-CELLS))
  (display " sbs/bar/oracle by up,range,down=") (display (list (hash-ref r "sbs-by-regime") (hash-ref r "bar-by-regime") (hash-ref r "oracle-by-regime")))
  (newline)
  (for-each (lambda (d) (display "P3S   def ") (display (hash-ref d "def")) (display " train=") (display (hash-ref d "train"))
              (display " noise=") (display (hash-ref d "noise")) (display " up=") (display (hash-ref d "trend-up"))
              (display " down=") (display (hash-ref d "trend-down")) (newline)) (hash-ref r "bar-defs"))) rows)
(display "P3S ms=") (display ms) (newline)
(display "P3S_OK") (newline)
